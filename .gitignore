# Local credentials (the checked-in template is intentionally retained).
.env
.env.*
!.env.example

# OS/editor temporary files.
.DS_Store
._*
Thumbs.db
Desktop.ini
~$*
*.swp
*.swo

# Dependencies, builds and test caches.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
node_modules/
frontend/dist/
.coverage
.coverage.*
htmlcov/
playwright-report/
test-results/
