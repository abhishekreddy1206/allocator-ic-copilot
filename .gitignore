# Local run outputs and private datasets. Reviewed docs/examples stay tracked.
/artifacts/
/exports/
/uploads/
/local-data/
/backups/
/pgdata/
*.log

# Downloaded inference weights belong in the runtime cache, not this repository.
.ollama/
*.gguf
*.safetensors
